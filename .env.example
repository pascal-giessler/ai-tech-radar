# Optional GitHub token — raises the API rate limit from 60 to 5000 req/h.
# Without it the radar still works, just with slower discovery.
GITHUB_TOKEN=

# How often the radar re-scans GitHub (minutes).
INGEST_INTERVAL_MINUTES=30

# Public URL of the site (used in sitemap, canonical links, llms.txt).
SITE_URL=http://localhost:3000

# Postgres password for the bundled database.
POSTGRES_PASSWORD=airadar
